#!/usr/bin/env bash
# E-AC-3 5.1 source: counts as a suitable surround track, so no AC-3 is created; only the stereo AAC is added (+1).
SCRIPT="$1"
source "$(dirname "$0")/_common.sh"
tmp_setup

make_source src.mkv 6 eac3 -b:a 640k
orig=$(track_count src.mkv)
run_script src.mkv || fail "script exited non-zero: $LAST_OUTPUT"
assert_output_contains "Skipping AC-3 5.1 creation"
assert_file src_stereo.mkv
assert_eq "track count" "$(track_count src_stereo.mkv)" "$((orig + 1))"
assert_eq "AC-3 tracks (none created)" "$(codec_count src_stereo.mkv AC-3)" "0"
