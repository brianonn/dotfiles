#!/usr/bin/env bash

export NEWT_COLORS='
root=white,black
border=blue,black
window=white,black
shadow=black,black
title=white,black
textbox=white,black
button=white,blue
actbutton=white,blue
compactbutton=white,black
listbox=white,black
actlistbox=white,blue
entry=white,black
disentry=gray,black
checkbox=white,black
actcheckbox=white,blue
helpline=gray,black
roottext=white,black
emptyscale=blue,black
fullscale=white,blue
'

# TODO: generate a dynamic list of installed terminal windows
# TODO: gum choose  --header "Choose a terminal" Wezterm alacrity cool-retro-term
# TODO: --gui : use rofi , --tui use current whiptail, none, use gum if it's present or just a list with readline

choice=$(whiptail --title "Choose a Terminal" \
    --menu "Which terminal would you like to launch?" \
    15 60 6 \
    "ghostty"   "Ghostty" \
    "wezterm"   "WezTerm" \
    "alacritty" "Alacritty" \
    "contour"   "Contour" \
    "xterm"     "XTerm" \
    "urxvt"     "rxvt-unicode" \
    2>&1 >/dev/tty)

case "$choice" in
    ghostty|wezterm|alacritty|contour|xterm|urxvt)
        "$choice" &
        ;;
    *)
        echo "Cancelled."
        ;;
esac

