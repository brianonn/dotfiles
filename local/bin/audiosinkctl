#!/usr/bin/env bash

set -eo pipefail

myname="$(basename "$0")"

# for notify-send
URGENCY=low  # low, normal, critical

# first turn long args into short args for getopts to use
args=()
while [ $# -gt 0 ]; do
    case "$1" in
        --gui)      args+=(-g)   ;;
        --tui)      args+=(-t)   ;;
        --query)    args+=(-q)   ;;
        --verbose)  args+=(-v)   ;;
        --help)     args+=(-h)   ;;
        --)         args+=("$@") ;;
        *)          args+=("$1") ;;
    esac
    shift
done

# set the new args
set -- "${args[@]}"

# now use getopts which doesn't support long args
gui=""
tui=""
query=""
verbose=""
while getopts "hvgtq" OPT; do
    case "$OPT" in
        g) gui=1
           if [[ -z $DISPLAY ]]; then
               echo '$DISPLAY is required for GUI mode. Please set $DISPLAY and try again'
               exit 1
            fi
            ;;
        t) tui=1 ;;
        q) query=1
           DEFAULT_SINK="$(pactl get-default-sink)"
           DESCRIPTION="$(pactl -f json list sinks | jq -r --arg sink "$DEFAULT_SINK" '.[] | select(.name == $sink) | .description')"
           echo $DESCRIPTION
           exit 0
           ;;
        v) verbose="-v" ;;
        h) echo "Usage: $myname [-h | --help]"
           echo "   or: $myname [-v | --verbose] [-t | --tui | -g | --gui]"
           echo "   or: $myname [-v | --verbose] [list | NUMBER]"
           exit 0
           ;;
        \?) exit 1 ;;
    esac
done

# User alias file, one entry per line: "match|Friendly name[|icon]"
# match is a sink name (see: pactl list short sinks) or a Bluetooth device name.
# Blank lines and lines starting with # are ignored. Icons are notifier icon
# names, typically placed in ~/.local/share/icons.
ALIAS_FILE="${AUDIOSINKCTL_ALIASES:-${XDG_CONFIG_HOME:-$HOME/.config}/audiosinkctl/aliases}"

# Populates SINK, NAME, ICON and SINK_COUNT from the live sinks so that every
# mode (CLI, GUI, TUI) shares one discovery and naming path. Index 0 is a
# placeholder so menu numbers start at 1.
#
# Name precedence, highest to lowest:
#   1. Custom alias, matched by sink name or Bluetooth device name
#   2. Discovered friendly name (Bluetooth device name, else sink description)
#   3. Raw sink name
discover_sinks() {
    local json
    if ! json="$(pactl -f json list sinks)"; then
        echo "$myname: unable to list audio sinks (is pactl running?)" >&2
        exit 1
    fi

    local -A alias_name=() alias_icon=()
    if [[ -r $ALIAS_FILE ]]; then
        local key a_name a_icon
        while IFS='|' read -r key a_name a_icon || [[ -n $key ]]; do
            if [[ -z $key || $key == \#* ]]; then
                continue
            fi
            alias_name["$key"]="$a_name"
            alias_icon["$key"]="$a_icon"
        done < "$ALIAS_FILE"
    fi

    SINK=("null")
    NAME=("null")
    ICON=("null")

    # unit separator keeps empty fields intact (tab would be collapsed by read)
    local sink_name sink_desc bt_name bt_addr sink_icon label icon
    while IFS=$'\x1f' read -r sink_name sink_desc bt_name bt_addr sink_icon; do
        label="${bt_name:-$sink_desc}"
        icon="${sink_icon:-audio-card}"

        if [[ -n ${alias_name[$sink_name]} ]]; then
            label="${alias_name[$sink_name]}"
            [[ -n ${alias_icon[$sink_name]} ]] && icon="${alias_icon[$sink_name]}"
        elif [[ -n $bt_name && -n ${alias_name[$bt_name]} ]]; then
            label="${alias_name[$bt_name]}"
            [[ -n ${alias_icon[$bt_name]} ]] && icon="${alias_icon[$bt_name]}"
        fi

        SINK+=("$sink_name")
        NAME+=("$label")
        ICON+=("$icon")
    done < <(jq -r '.[] | [
                .name,
                (.description // .name),
                (.properties["device.alias"] // ""),
                (.properties["api.bluez5.address"] // ""),
                (.properties["api.bluez5.icon"] // .properties["device.icon_name"] // "")
            ] | join("\u001f")' <<< "$json")

    # 1 less than the true count since we are skipping index 0
    SINK_COUNT=$(( ${#NAME[@]} - 1 ))
    if (( SINK_COUNT == 0 )); then
        echo "$myname: no audio sinks found" >&2
        exit 1
    fi
}

discover_sinks

# Non-interactive CLI: "list" prints the numbered outputs, "[n]" selects output n
index=""
shift $((OPTIND - 1))
if [[ $# -gt 1 ]]; then
    echo "Usage: $myname [list | NUMBER]" >&2
    exit 1
elif [[ $# -eq 1 ]]; then
    if [[ -n $gui || -n $tui ]]; then
        echo "$myname: 'list' and NUMBER cannot be combined with -g/--gui or -t/--tui" >&2
        exit 1
    fi
    if [[ $1 == list ]]; then
        for ((i=1; i <= $SINK_COUNT; i++)); do
            printf "%d) %s\n" "$i" "${NAME[i]}"
        done
        exit 0
    fi
    if [[ ! $1 =~ ^[1-9][0-9]*$ ]] || (( $1 > SINK_COUNT )); then
        echo "$myname: invalid output number '$1' (choose 1-$SINK_COUNT, or 'list')" >&2
        exit 1
    fi
    index=$1
fi

# Present choices
if [[ -n $index ]]; then
    # chosen on the command line, no menu
    :
elif [[ -n $gui ]]; then
    # for GUI
    index=$(printf '%s\n' "${NAME[@]}" | command tail -n +2 | rofi -dmenu -format i -i -p "Select Audio Output:")
    status="$?"
    if [[ -z $index ]] || [[ $status != 0 ]]; then
        exit $status
    fi
    index=$((index + 1))
elif [[ -n $tui ]]; then
    # for TUI
    echo "TUI coming soon!"
    exit 1
else
    # for terminal
    for ((i=1; i <= $SINK_COUNT; i++)); do
        printf "%d) %s\n" "$i" "${NAME[i]}"
    done
    echo
    echo "0) Exit. No change."
    printf "\nChoose the audio output sink device: "
    read index
    if [[ $index -le 0 ]] || [[ $index -gt $SINK_COUNT ]]; then
        exit 1;
    fi
fi

# Apply the pactl commands based on selected index
pactl set-default-sink "${SINK[$index]}"
pactl list short sink-inputs | awk '{print $1}' | xargs -I {} pactl move-sink-input {} "${SINK[$index]}"

if [[ -n $gui ]]; then
    notify-send "Audio Output" "Switched to ${NAME[$index]}" -i "${ICON[index]}" -u $URGENCY
else
    printf "Audio output switched to: ${NAME[$index]}"
fi

exit 0
